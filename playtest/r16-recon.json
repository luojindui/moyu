ct=\"decor\" data-id=\"fridge\" data-disabled=\"1\">\n        <span class=\"talent-dot\" aria-hidden=\"true\"></span>\n        <span class=\"talent-info\">\n          <span class=\"talent-name\">迷你冰箱</span>\n          <span class=\"talent-desc\">工位挂机 +8%</span>\n          \n        </span>\n        <button data-act=\"decor\" data-id=\"fridge\" aria-label=\"购买：迷你冰箱，60.00万，效果工位挂机 +8%\" disabled=\"\">60.00万</button>\n      </div><div class=\"talent row-tap \" data-act=\"decor\" data-id=\"chair\" data-disabled=\"1\">\n        <span class=\"talent-dot\" aria-hidden=\"true\"></span>\n        <span class=\"talent-info\">\n          <span class=\"talent-name\">按摩椅</span>\n          <span class=\"talent-desc\">离线效率 +8%</span>\n          \n        </span>\n        <button data-act=\"decor\" data-id=\"chair\" aria-label=\"购买：按摩椅，400.00万，效果离线效率 +8%\" disabled=\"\">400.00万</button>\n      </div><div class=\"talent row-tap \" data-act=\"decor\" data-id=\"aquarium\" data-disabled=\"1\">\n        <span class=\"talent-dot\" aria-hidden=\"true\"></span>\n        <span class=\"talent-info\">\n          <span class=\"talent-name\">鱼缸</span>\n          <span class=\"talent-desc\">挂机 +10%、点击 +10%</span>\n          \n        </span>\n        <button data-act=\"decor\" data-id=\"aquarium\" aria-label=\"购买：鱼缸，3000.00万，效果挂机 +10%、点击 +10%\" disabled=\"\">3000.00万</button>\n      </div><div class=\"talent row-tap \" data-act=\"decor\" data-id=\"projector\" data-disabled=\"1\">\n        <span class=\"talent-dot\" aria-hidden=\"true\"></span>\n        <span class=\"talent-info\">\n          <span class=\"talent-name\">投影仪</span>\n          <span class=\"talent-desc\">派遣奖励 +30%</span>\n          \n        </span>\n        <button data-act=\"decor\" data-id=\"projector\" aria-label=\"购买：投影仪，2.00亿，效果派遣奖励 +30%\" disabled=\"\">2.00亿</button>\n      </div><div class=\"talent row-tap \" data-act=\"decor\" data-id=\"catbed\" data-disabled=\"1\">\n        <span class=\"talent-dot\" aria-hidden=\"true\"></span>\n        <span class=\"talent-info\">\n          <span class=\"talent-name\">工位猫窝</span>\n          <span class=\"talent-desc\">挂机 +15%、离线 +10%</span>\n          \n        </span>\n        <button data-act=\"decor\" data-id=\"catbed\" aria-label=\"购买：工位猫窝，20.00亿，效果挂机 +15%、离线 +10%\" disabled=\"\">20.00亿</button>\n      </div>",
