    "teamColleaguesHTML": "<div class=\"team-summary\">\n      <span>已招募 0/5 · 小队挂机 +0/秒</span>\n      \n      <span style=\"width:100%;font-size:10px;color:#8f9fd0\">自动重复：完成后自动领取并续班（离线回来最多补 1 轮）</span>\n    </div><div class=\"mate locked\">\n          <div class=\"mate-top\">\n            <span class=\"mate-name\">老周</span>\n            <span class=\"mate-role\">八年老员工·甩锅大师</span>\n          </div>\n          <div class=\"mate-skill\">擅长：聊八卦（匹配的派遣 +50%）</div>\n          <div class=\"mate-skill\" style=\"color:#8be28b\">被动：他的任务更快（时长 -15%）</div>\n          <div class=\"mate-actions\">\n            <button data-act=\"recruit\" data-id=\"zhou\">\n              招募 1.20万\n            </button>\n          </div>\n        </div><div class=\"team-hint\" style=\"font-size:12px\">还有 4 位同事，攒够钱陆续解锁。</div>",
    "teamTalentsHTML": "<div class=\"branch\">\n        <h3>点击流 · 手速摸鱼 <small style=\"color:#8f9fd0\">（0/5 · 点击力 ×1.00）</small></h3>\n        <div class=\"talent \">\n            <span class=\"talent-dot\">1</span>\n            <span class=\"talent-info\">\n              <span class=\"talent-name\">手速</span>\n              <span class=\"talent-desc\">点击力 +25%</span>\n            </span>\n            <button data-act=\"talent\" data-id=\"click_1\">点亮 1</button>\n          </div><div class=\"talent \">\n            <span class=\"talent-dot\">2</span>\n            <span class=\"talent-info\">\n              <span class=\"talent-name\">连击窗口</span>\n              <span class=\"talent-desc\">连击窗口 0.5s → 0.65s</span>\n            </span>\n            <button data-act=\"talent\" data-id=\"click_2\" disabled=\"\">点亮 1</button>\n          </div><div class=\"talent \">\n            <span class=\"talent-dot\">3</span>\n            <span class=\"talent-info\">\n              <span class=\"talent-name\">连击上限（2点）</span>\n              <span class=\"talent-desc\">连击上限 20 → 30（最高 ×1.36）</span>\n            </span>\n            <button data-act=\"talent\" data-id=\"click_3\" disabled=\"\">点亮 2</button>\n          </div><div class=\"talent \">\n            <span class=\"talent-dot\">4</span>\n            <span class=\"talent-info\">\n              <span class=\"talent-name\">暴击（2点）</span>\n              <span class=\"talent-desc\">每 20 次点击必暴击 ×5（巡逻偷点不触发）</span>\n            </span>\n            <button data-act=\"talent\" data-id=\"click_4\" disabled=\"\">点亮 2</button>\n          </div><div class=\"talent \">\n            <span class=\"talent-dot\">5</span>\n            <span class=\"talent-info\">\n              <span class=\"talent-name\">摸鱼转正（终极·3点）</span>\n              <span class=\"talent-desc\">每 300 次累计点击 → 挂机 +1%（封顶 +35%）</span>\n            </span>\n            <button data-act=\"talent\" data-id=\"click_5a\" disabled=\"\">点亮 3</button>\n          </div><div class=\"talent \">\n            <span class=\"talent-dot\">5</span>\n            <span class=\"talent-info\">\n              <span class=\"talent-name\">指尖风暴（终极·3点）</span>\n              <span class=\"talent-desc\">立即 +12% 挂机；此后每 1000 次累计点击再 +1%（封顶 +32%）+ 点击力 +60%</span>\n            </span>\n            <button data-act=\"talent\" data-id=\"click_5b\" disabled=\"\">点亮 3</button>\n          </div>\n      </div><div class=\"team-hint\" style=\"font-size:12px\">挂机流 · 稳如老狗：攒到 3 点后展开</div><div class=\"team-hint\" style=\"font-size:12px\">事件流 · 摸鱼情报：攒到 3 点后展开</div><div class=\"mate-actions\">\n      <button class=\"ghost\" data-act=\"reset-talents\">重置天赋（返还全部点数）</button>\n    </div><div class=\"talent-progress\">\n      <div>点击转化：0/10500 次（当前 +0%）</div>\n      <div>安然转化：0/30 次（当前 +0%）</div>\n      <div>溢出转化：0/30 点（当前 +0.0% 挂机，封顶 +15%）</div>\n      <div style=\"color:#a8a493\">天赋点：每次转生 +1；段位 3/5/7/9/11/13 档各 +1；每日首开 +1（上限 24，满树需 27 点 → 终局必须放弃一条流派）</div>\n    </div>",
    "teamDecorHTML": "<div class=\"team-summary\">\n      <span>已装修 0/8 · 挂机 ×1.00 · 点击 ×1.00 · 离线 +0%</span>\n    </div><div class=\"branch\">\n      <h3>今日精力 <small style=\"color:#8f9fd0\">（剩 100/100）</small></h3>\n      <div class=\"talent row-tap \" data-act=\"energy\" data-id=\"slack\" data-disabled=\"0\">\n          <span class=\"talent-dot\" aria-hidden=\"true\">40</span>\n          <span class=\"talent-info\">\n            <span class=\"talent-name\">认真摸鱼</span>\n            <span class=\"talent-desc\">今天挂机 +25% · 花 40 精力</span>\n            \n          </span>\n          <button data-act=\"energy\" data-id=\"slack\" aria-label=\"使用：认真摸鱼（消耗 40 精力，今天挂机 +25%）\">使用</button>\n        </div><div class=\"talent row-tap \" data-act=\"energy\" data-id=\"fake-work\" data-disabled=\"0\">\n          <span class=\"talent-dot\" aria-hidden=\"true\">35</span>\n          <span class=\"talent-info\">\n            <span class=\"talent-name\">假装工作</span>\n            <span class=\"talent-desc\">今天巡逻奖励 ×2.2 · 花 35 精力</span>\n            \n          </span>\n          <button data-act=\"energy\" data-id=\"fake-work\" aria-label=\"使用：假装工作（消耗 35 精力，今天巡逻奖励 ×2.2）\">使用</button>\n        </div><div class=\"talent row-tap \" data-act=\"energy\" data-id=\"social\" data-disabled=\"1\">\n          <span class=\"talent-dot\" aria-hidden=\"true\">25</span>\n          <span class=\"talent-info\">\n            <span class=\"talent-name\">跟同事聊天</span>\n            <span class=\"talent-desc\">全体好感 +5，且今天挂机 +5% · 花 25 精力 · 还没有同事，暂不可用</span>\n            \n          </span>\n          <button data-act=\"energy\" data-id=\"social\" aria-label=\"使用：跟同事聊天（消耗 25 精力，全体好感 +5，且今天挂机 +5%）\" disabled=\"\">使用</button>\n        </div><div class=\"talent row-tap \" data-act=\"energy\" data-id=\"focus\" data-disabled=\"0\">\n          <span class=\"talent-dot\" aria-hidden=\"true\">45</span>\n          <span class=\"talent-info\">\n            <span class=\"talent-name\">专注点击</span>\n            <span class=\